# Copy this file to .env and adjust for your environment.
# The values below are development defaults; change every password before
# deploying to a shared or production environment.

# ------------
# App
# dev / test / prod
# APP_ENV=dev

# Address the Go process listens on. Used by `go run`; compose pins the
# container to :8888 so the port mapping stays stable.
# HTTP_ADDR=:8888

# Host port that compose publishes for the API (direct access).
# HTTP_PORT=8888

# ------------
# MySQL
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_DATABASE=simple
# MYSQL_USER=simple
# MYSQL_PASSWORD=simple
# MYSQL_ROOT_PASSWORD=simple-root

# ------------
# PostgreSQL
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=simple
# POSTGRES_USER=simple
# POSTGRES_PASSWORD=simple

# ------------
# Redis
# REDIS_HOST=redis
# REDIS_PORT=6379
# Empty means no password. For production, set it and add --requirepass to
# the redis command in docker-compose.yml.
# REDIS_PASSWORD=

# ------------
# Nginx
# Host port that compose publishes for the reverse proxy.
# NGINX_PORT=8080
